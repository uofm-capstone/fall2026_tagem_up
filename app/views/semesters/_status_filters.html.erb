<!-- Team, Sprint, and Grading Stage Filters -->
<div class="semesters-status__filters d-flex flex-wrap justify-content-center align-items-end gap-3 mb-4">
  <div class="d-flex flex-column align-items-start gap-1" style="width: 200px;">
    <label for="team-filter" class="fw-bold me-2">Team:</label>

    <select id="team-filter" class="form-select">
      <option value="all">All Teams</option>

      <% teams.each do |team| %>
        <option value="<%= team.id %>"><%= team.name %></option>
      <% end %>
    </select>
  </div>

  <div class="d-flex flex-column align-items-start gap-1" style="width: 200px;">
    <label for="sprint-filter" class="fw-bold me-2">Sprint:</label>

    <select id="sprint-filter" class="form-select">
      <% sprint_list.each do |sprint| %>
        <option value="<%= sprint.parameterize %>"><%= sprint %></option>
      <% end %>
    </select>
  </div>

  <div class="d-flex flex-column align-items-start gap-1" style="width: 200px;">
    <label for="stage-filter" class="fw-bold me-2">Stage:</label>

    <select id="stage-filter" class="form-select">
      <option value="planning">Planning</option>
      <option value="progress">Progress Check</option>
      <option value="demo">Demo Day</option>
    </select>
  </div>

</div>