<%= turbo_frame_tag "semester-status-content" do %>
  <div data-status-content-ready="1"
       data-status-refreshing="<%= @status_snapshot_refreshing ? '1' : '0' %>"
       class="d-none"
       aria-hidden="true"></div>

  <div class="row">
    <div class="mt-4 text-center">

      <% if @status_snapshot_refreshing %>
        <div class="alert alert-info" role="status">
          <span class="spinner-border spinner-border-sm me-2"
                aria-hidden="true"></span>
          Generating the status snapshot in the background.
          This page will update automatically when it is ready.
        </div>
      <% else %>
        <% if @status_snapshot_failed %>
          <div class="alert alert-warning" role="alert">
            Status snapshot generation failed. Please try again.
          </div>
        <% else %>
          <div class="alert alert-info" role="status">
            No saved status snapshot is available for this semester.
            Click below to generate one.
          </div>
        <% end %>

        <%= link_to(
          @status_snapshot_failed ? "Retry Snapshot Generation" : "Build Initial Status Snapshot",
          semester_status_path(@semester, force_refresh: 1, debug: params[:debug]),
          class: "btn btn-primary btn-sm"
        ) %>
      <% end %>
    </div>
  </div>
<% end %>