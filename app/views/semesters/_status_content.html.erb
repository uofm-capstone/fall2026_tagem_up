<%= turbo_frame_tag "semester-status-content" do %>
  <div data-status-content-ready="1"
       data-status-refreshing="<%= @status_snapshot_refreshing ? '1' : '0' %>"
       class="d-none"
       aria-hidden="true"></div>

  <% if @status_snapshot_built_at.present? %>
    <div class="alert alert-info text-center mb-3">
      Status snapshot updated
      <strong id="status-snapshot-age"
              data-built-at="<%= @status_snapshot_built_at.iso8601 %>"
              title="<%= @status_snapshot_built_at.in_time_zone('America/Chicago').strftime('%b %-d, %Y %-l:%M %p CT') %>">
        <%= time_ago_in_words(@status_snapshot_built_at) %> ago
      </strong>.
    </div>
  <% end %>

  <% if @status_snapshot_refreshing %>
    <div class="alert alert-info text-center mb-3" role="status">
      <span class="spinner-border spinner-border-sm me-2"
            aria-hidden="true"></span>
      Updating status snapshot. Previously saved metrics are displayed below.
    </div>
  <% elsif @status_snapshot_failed %>
    <div class="alert alert-warning text-center mb-3" role="alert">
      Snapshot update failed. Previously saved metrics are displayed below.
      Please try updating again.
    </div>
  <% end %>

  <div class="row semesters-status__content-row">
    <div class="text-center semesters-status__content">

      <% if team_exist(@teams) %>
      
        <%= render "semesters/status_filters",
          sprint_list: @sprint_list,
          teams: @teams %>

        <% if @show_github_inspector %>
          <%= render "semesters/github_data_inspector",
            teams: @teams,
            github_inspector: @github_inspector %>
        <% end %>

        <%= render "semesters/status_metrics_table",
          sprint_list: @sprint_list,
          teams: @teams,
          team_overview_by_id: @team_overview_by_id,
          semester: @semester,
          team_sprint_metrics: @team_sprint_metrics,
          status_metrics: @status_metrics %>

              
        <%#= render "semesters/demo_day_status",
          teams: @teams,
          sprint_list: @sprint_list,
          team_sprint_metrics: @team_sprint_metrics #%>

        <div id="sponsor-modals-container">
          <%= render "semesters/sponsor_response_modals" %>
        </div>

        <%= render "semesters/grading_rubric_modal" %>

      <% else %>

        <h2>Team Status</h2>

        <div class="alert alert-warning" role="status">
          No teams found for this semester, so status metrics cannot be displayed yet.
        </div>

      <% end %>

    </div>
  </div>
<% end %>