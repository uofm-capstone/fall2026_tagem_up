<!-- TABLE -->
<div class="table-responsive team-status-table-wrap">

  <div class="status-card-layout">

    <% sprint_list.each do |sprint| %>
      <% sprint_key = sprint.parameterize %>

      <div class="sprint-group <%= sprint_key %>">

        <% teams.each do |team| %>
          <% team_metric = team_sprint_metrics.dig(team.id, sprint) || {} %>

          <div class="card mb-4">
          <div class="card-header d-flex align-items-center justify-content-between gap-2">
            <div class="d-flex align-items-center gap-2">
              <strong><%= team.name %></strong>

              <% if team_metric[:at_risk] %>
                <span
                  class="team-risk-badge"
                  data-bs-toggle="tooltip"
                  data-bs-placement="top"
                  title="<%= Array(team_metric[:at_risk_reasons]).join('; ') %>">
                  At Risk
                </span>
              <% end %>
            </div>

            <div class="d-flex align-items-center gap-2">
              <span class="small text-muted">Team Progress:</span>

              <% if team_metric[:pp_band] == "No Data" || team_metric[:pp_completion_pct].nil? %>
                <span class="text-muted small">No data available</span>
              <% else %>
                <span class="github-score-badge <%= product_progress_state_class(team_metric[:pp_completion_pct]) %>">
                  <%= team_metric[:pp_completion_pct] %>%
                </span>

                <span class="github-band">
                  <%= team_metric[:pp_band] %>
                </span>
              <% end %>
            </div>
          </div>

            <div class="card-body">

              <div class="stage-layout" data-card-stage="planning">
                <h6 class="fw-bold mb-2">Team Evaluation</h6>

                <div class="table-responsive mb-4">
                  <table class="table table-bordered text-center align-middle mb-0">
                    <thead>
                      <tr>
                        <th
                          data-bs-toggle="tooltip"
                          data-bs-placement="top"
                          title="Number of sprint cards grouped by status: Backlog, Todo, In Progress, and Done.">
                          Feature Selection &amp; Decomposition
                        </th>
                        <th
                          data-bs-toggle="tooltip"
                          data-bs-placement="top"
                          title="Total number of sprint cards assigned to team members.">
                          Feature Assignments
                        </th>
                        <th
                          data-bs-toggle="tooltip"
                          data-bs-placement="top"
                          title="Evaluates sprint-start Kanban organization: selected tasks in Todo, unselected tasks in Backlog, In Progress and Done cleared, and previous sprint work archived or recycled. Requires evaluation at the sprint-start checkpoint.">
                          Kanban Updates
                        </th>
                      </tr>
                    </thead>

                    <tbody>
                      <tr>
                        <td>
                          B: <%= team_metric[:backlog_cards] || 0 %> ·
                          T: <%= team_metric[:todo_cards] || 0 %> ·
                          IP: <%= team_metric[:in_progress_cards] || 0 %> ·
                          D: <%= team_metric[:done_cards] || 0 %>
                        </td>

                        <td>
                          <%= team.students.sum { |student|
                            status_metrics.dig(
                              team.id,
                              student.id,
                              sprint,
                              :fa,
                              :assigned_cards
                            ).to_i
                          } %>
                        </td>

                        <td>
                          <span class="text-muted"
                                data-bs-toggle="tooltip"
                                data-bs-placement="top"
                                title="Kanban Updates has not been evaluated against the sprint-start rubric.">
                            <i class="bi bi-question-circle"></i>
                            Not Evaluated
                          </span>
                        </td>
                      </tr>
                    </tbody>
                  </table>
                </div>

                <h6 class="fw-bold mb-2">Individual Evaluation</h6>

                <div class="table-responsive">
                  <table class="table table-bordered text-center align-middle mb-0">
                    <thead>
                      <tr>
                        <th>Member</th>
                        <th
                          data-bs-toggle="tooltip"
                          data-bs-placement="top"
                          title="Estimated hours for this student's assigned sprint cards.">
                          Time Estimate
                        </th>
                      </tr>
                    </thead>

                    <tbody>
                      <% team.students.each do |student| %>
                        <% metric = status_metrics.dig(team.id, student.id, sprint) || {} %>

                        <tr>
                          <td>
                            <%= "#{student.name.split.first} #{student.name.split.last&.first}." %>
                          </td>

                          <td>
                            <%= metric.dig(:te, :estimated_hours) || 0 %>
                          </td>
                        </tr>
                      <% end %>
                    </tbody>
                  </table>
                </div>
              </div>

              <div class="stage-layout" data-card-stage="progress">

                <h6 class="fw-bold mb-2">Team Evaluation</h6>

                <div class="table-responsive mb-4">
                  <table class="table table-bordered text-center align-middle mb-0">
                    <thead>
                      <tr>
                        <th data-bs-toggle="tooltip"
                            data-bs-placement="top"
                            title="Team evaluation: Did the team meet with the client or attempt to contact them, document meeting feedback, schedule the next meeting, and update the Kanban backlog based on feedback when needed?">
                          Client Communication
                        </th>
                        <th data-bs-toggle="tooltip"
                            data-bs-placement="top"
                            title="Team evaluation: Did the team communicate its progress, blockers, risks, and support needs to the professor?">
                          Status &amp; Reflection
                        </th>
                      </tr>
                    </thead>

                    <tbody>
                      <tr>
                        <td>
                          <% if team.client_notes_url.present? %>
                            <%= link_to "Client Notes Available",
                                team.client_notes_url,
                                class: "btn btn-outline-secondary btn-sm link-button available",
                                target: "_blank",
                                rel: "noopener noreferrer",
                                data: {
                                  bs_toggle: "tooltip",
                                  bs_placement: "top",
                                  bs_title: "Client meeting notes link is available. Meeting activity and rubric compliance have not been verified."
                                } %>
                          <% else %>
                            <span class="btn btn-outline-secondary btn-sm link-button missing"
                                  data-bs-toggle="tooltip"
                                  data-bs-placement="top"
                                  title="No client meeting notes link has been provided.">
                              Client Notes Missing
                            </span>
                          <% end %>
                        </td>
                        <td>
                          <div class="d-inline-flex align-items-center gap-2">
                            <span class="ui-tooltip"
                                  tabindex="0"
                                  aria-label="Not Evaluated"
                                  data-tooltip="Status & Reflection has not been evaluated against the instructor's rubric."
                              <%= image_tag "question-circle-fill.svg",
                                  class: "team-status-icon",
                                  alt: "",
                                  aria: { hidden: true } %>
                            </span>
                            <span class="text-muted">Not Evaluated</span>
                          </div>
                        </td>
                      </tr>
                    </tbody>
                  </table>
                </div>

                <h6 class="fw-bold mb-2">Individual Evaluation</h6>

                <div class="table-responsive">
                  <table class="table table-bordered text-center align-middle mb-0">
                    <thead>
                      <tr>
                        <th>Member</th>
                        <th
                          data-bs-toggle="tooltip"
                          data-bs-placement="top"
                          title="Total hours logged in the Kanban Time Taken or Time Spent fields for this student's sprint cards.">
                          Time Spent
                        </th>
                        <th
                          data-bs-toggle="tooltip"
                          data-bs-placement="top"
                          title="Automated task-completion indicator based on assigned sprint cards. The instructor's Product Progress evaluation also considers progress toward individual goals, explanations for incomplete work, accurate Kanban status, and recorded task times. This percentage is not an official grade.">
                          Product Progress
                        </th>
                        <th
                          data-bs-toggle="tooltip"
                          data-bs-placement="top"
                          title="Automated GitHub activity indicator combining Kanban activity, code contributions, pull requests, and code reviews. GH is the composite score; CBP measures code contributions, PR measures pull requests, and RVW measures reviews. This score is not an official instructor grade.">
                          Code Contribution &amp; Source Control
                        </th>
                      </tr>
                    </thead>

                    <tbody>
                      <% team.students.each do |student| %>
                        <% metric = status_metrics.dig(team.id, student.id, sprint) || {} %>
                        <% done_count = metric.dig(:fsd, :done).to_i %>
                        <% total_count = metric.dig(:fa, :assigned_cards).to_i %>

                        <tr>
                          <td>
                            <%= "#{student.name.split.first} #{student.name.split.last&.first}." %>
                          </td>

                          <td>
                            <%= metric.dig(:ts, :time_spent_hours) || 0 %>
                          </td>

                          <td>
                            <% pp_score = metric.dig(:pp, :completion_pct) %>
                            <% pp_band = metric.dig(:pp, :band) || "No Data" %>

                            <% if pp_band == "No Data" || pp_score.nil? %>
                              <span class="text-muted">No data available</span>
                            <% else %>
                              <div class="github-score-cell">
                                <span class="github-score-badge <%= product_progress_state_class(pp_score) %>">
                                  <%= pp_score %>%
                                </span>

                                <span class="github-band">
                                  <%= pp_band %>
                                </span>

                                <div class="github-band">
                                  <%= done_count %>/<%= total_count %> done
                                </div>
                              </div>
                            <% end %>
                          </td>

                          <td>
                            <% if metric.dig(:github, :data_available) %>

                              <% github_metric = metric[:github] || {} %>

                              <div class="github-score-cell mb-2">

                                <% if github_metric[:band] != "No Data" %>
                                  <span class="github-score-badge <%= github_score_state_class(github_metric[:score]) %>">
                                    <%= github_metric[:score] %>%
                                  </span>

                                  <span class="github-band">
                                    <%= github_metric[:band] %>
                                  </span>
                                <% else %>
                                  <span class="github-band">No score available</span>
                                <% end %>

                                <div class="github-score-chips">
                                  <% [
                                    ["GH", github_metric[:score]],
                                    ["CBP", github_metric[:cbp_score]],
                                    ["PR", github_metric[:pr_score]],
                                    ["RVW", github_metric[:review_score]]
                                  ].each do |label, score| %>
                                    <span
                                      class="github-chip"
                                      data-bs-toggle="tooltip"
                                      data-bs-placement="top"
                                      title="<%= github_chip_tooltip(label) %>">
                                      <%= label %> <%= score.nil? ? "N/A" : compact_score(score) %>
                                    </span>
                                  <% end %>
                                </div>

                              </div>

                              <div>
                                Commits: <%= metric.dig(:cbp, :commit_count).to_i %>
                              </div>

                              <div>
                                Lines Changed: <%= metric.dig(:cbp, :lines_changed).to_i %>
                              </div>

                              <div>
                                PRs:
                                <%= metric.dig(:pr, :opened_count).to_i %> opened,
                                <%= metric.dig(:pr, :merged_count).to_i %> merged
                              </div>

                              <div>
                                Reviews: <%= metric.dig(:review, :review_count).to_i %>
                              </div>

                              <div class="small text-muted">
                                Last Commit:
                                <%= formatted_last_commit_display(metric) %>
                              </div>

                            <% else %>

                              <div class="text-muted">
                                GitHub contribution metrics unavailable
                              </div>

                              <div class="small text-muted">
                                Last Commit:
                                <%= formatted_last_commit_display(metric) %>
                              </div>

                            <% end %>
                          </td>
                        </tr>
                      <% end %>
                    </tbody>

                  </table>
                </div>

              </div>

              <div class="stage-layout" data-card-stage="demo">

                <h6 class="fw-bold mb-2">Team Evaluation</h6>

                <div class="table-responsive mb-4">
                  <table class="table table-bordered text-center align-middle mb-0">
                    <thead>
                      <tr>
                        <th data-bs-toggle="tooltip"
                            data-bs-placement="top"
                            title="Team evaluation: Did the team meet with the client or attempt to contact them, document meeting feedback, schedule the next meeting, and update the Kanban backlog based on feedback when needed?">
                          Client Communication
                        </th>
                        <th data-bs-toggle="tooltip"
                            data-bs-placement="top"
                            title="Team evaluation: Did the team demonstrate sprint progress, including the project overview, sprint goals, actions from previous reflections, progress evidence, next-sprint goals, and verbal feedback to another team?">
                          Demo
                        </th>
                      </tr>
                    </thead>

                    <tbody>
                      <tr>
                        <td>
                          <% if team.client_notes_url.present? %>
                            <%= link_to "Client Notes Available",
                                team.client_notes_url,
                                class: "btn btn-outline-secondary btn-sm link-button available",
                                target: "_blank",
                                rel: "noopener noreferrer",
                                data: {
                                  bs_toggle: "tooltip",
                                  bs_placement: "top",
                                  bs_title: "Client meeting notes link is available. Meeting activity and rubric compliance have not been verified."
                                } %>
                          <% else %>
                            <span class="btn btn-outline-secondary btn-sm link-button missing"
                                  data-bs-toggle="tooltip"
                                  data-bs-placement="top"
                                  title="No client meeting notes link has been provided.">
                              Client Notes Missing
                            </span>
                          <% end %>
                        </td>
                        <td>
                          <div class="d-inline-flex align-items-center gap-2">
                            <span class="ui-tooltip"
                                  tabindex="0"
                                  aria-label="Not Evaluated"
                                  data-tooltip="The team's sprint demonstration has not been evaluated against the instructor's Demo rubric."
                              <%= image_tag "question-circle-fill.svg",
                                  class: "team-status-icon",
                                  alt: "",
                                  aria: { hidden: true } %>
                            </span>
                            <span class="text-muted">Not Evaluated</span>
                          </div>
                        </td>
                      </tr>
                    </tbody>
                  </table>
                </div>

                <h6 class="fw-bold mb-2">Individual Evaluation</h6>

                <div class="table-responsive">
                  <table class="table table-bordered text-center align-middle mb-0">
                    <thead>
                      <tr>
                        <th>Member</th>
                        <th
                          data-bs-toggle="tooltip"
                          data-bs-placement="top"
                          title="Total hours logged in the Kanban Time Taken or Time Spent fields for this student's sprint cards.">
                          Time Spent
                        </th>
                        <th
                          data-bs-toggle="tooltip"
                          data-bs-placement="top"
                          title="Automated task-completion indicator based on assigned sprint cards. The instructor's Product Progress evaluation also considers progress toward individual goals, explanations for incomplete work, accurate Kanban status, and recorded task times. This percentage is not an official grade.">
                          Product Progress
                        </th>
                        <th data-bs-toggle="tooltip"
                            data-bs-placement="top"
                            title="Individual evaluation: Did the student evaluate another team, perform user testing or a code review, document the feedback received and planned improvements, and submit proof of feedback given and received?">
                          Product Feedback
                        </th>
                        <th
                          data-bs-toggle="tooltip"
                          data-bs-placement="top"
                          title="Automated GitHub activity indicator combining Kanban activity, code contributions, pull requests, and code reviews. GH is the composite score; CBP measures code contributions, PR measures pull requests, and RVW measures reviews. This score is not an official instructor grade.">
                          Code Contribution &amp; Source Control
                        </th>
                        <th data-bs-toggle="tooltip"
                            data-bs-placement="top"
                            title="Individual evaluation: Did the student submit a Reflection Survey describing their progress and experiences?">
                          Status &amp; Reflection
                        </th>
                      </tr>
                    </thead>

                    <tbody>
                      <% team.students.each do |student| %>
                        <% metric = status_metrics.dig(team.id, student.id, sprint) || {} %>
                        <% done_count = metric.dig(:fsd, :done).to_i %>
                        <% total_count = metric.dig(:fa, :assigned_cards).to_i %>

                        <tr>
                          <td>
                            <%= "#{student.name.split.first} #{student.name.split.last&.first}." %>
                          </td>

                          <td>
                            <%= metric.dig(:ts, :time_spent_hours) || 0 %>
                          </td>

                          <td>
                            <% pp_score = metric.dig(:pp, :completion_pct) %>
                            <% pp_band = metric.dig(:pp, :band) || "No Data" %>

                            <% if pp_band == "No Data" || pp_score.nil? %>
                              <span class="text-muted">No data available</span>
                            <% else %>
                              <div class="github-score-cell">
                                <span class="github-score-badge <%= product_progress_state_class(pp_score) %>">
                                  <%= pp_score %>%
                                </span>

                                <span class="github-band">
                                  <%= pp_band %>
                                </span>

                                <div class="github-band">
                                  <%= done_count %>/<%= total_count %> done
                                </div>
                              </div>
                            <% end %>
                          </td>

                          <td>
                            <div class="d-inline-flex align-items-center gap-2">
                              <span class="ui-tooltip"
                                    tabindex="0"
                                    aria-label="Not Evaluated"
                                    data-tooltip="Product Feedback has not been evaluated against the instructor's rubric."
                                <%= image_tag "question-circle-fill.svg",
                                    class: "team-status-icon",
                                    alt: "",
                                    aria: { hidden: true } %>
                              </span>
                              <span class="text-muted">Not Evaluated</span>
                            </div>
                          </td>

                          <td>
                            <% if metric.dig(:github, :data_available) %>

                              <% github_metric = metric[:github] || {} %>

                              <div class="github-score-cell mb-2">

                                <% if github_metric[:band] != "No Data" %>
                                  <span class="github-score-badge <%= github_score_state_class(github_metric[:score]) %>">
                                    <%= github_metric[:score] %>%
                                  </span>

                                  <span class="github-band">
                                    <%= github_metric[:band] %>
                                  </span>
                                <% else %>
                                  <span class="github-band">No score available</span>
                                <% end %>

                                <div class="github-score-chips">
                                  <% [
                                    ["GH", github_metric[:score]],
                                    ["CBP", github_metric[:cbp_score]],
                                    ["PR", github_metric[:pr_score]],
                                    ["RVW", github_metric[:review_score]]
                                  ].each do |label, score| %>
                                    <span
                                      class="github-chip"
                                      data-bs-toggle="tooltip"
                                      data-bs-placement="top"
                                      title="<%= github_chip_tooltip(label) %>">
                                      <%= label %> <%= score.nil? ? "N/A" : compact_score(score) %>
                                    </span>
                                  <% end %>
                                </div>

                              </div>

                              <div>
                                Commits: <%= metric.dig(:cbp, :commit_count).to_i %>
                              </div>

                              <div>
                                Lines Changed: <%= metric.dig(:cbp, :lines_changed).to_i %>
                              </div>

                              <div>
                                PRs:
                                <%= metric.dig(:pr, :opened_count).to_i %> opened,
                                <%= metric.dig(:pr, :merged_count).to_i %> merged
                              </div>

                              <div>
                                Reviews: <%= metric.dig(:review, :review_count).to_i %>
                              </div>

                              <div class="small text-muted">
                                Last Commit:
                                <%= formatted_last_commit_display(metric) %>
                              </div>

                            <% else %>

                              <div class="text-muted">
                                GitHub contribution metrics unavailable
                              </div>

                              <div class="small text-muted">
                                Last Commit:
                                <%= formatted_last_commit_display(metric) %>
                              </div>

                            <% end %>
                          </td>
                          <td>
                            <div class="d-inline-flex align-items-center gap-2">
                              <span class="ui-tooltip"
                                    tabindex="0"
                                    aria-label="Not Evaluated"
                                    data-tooltip="The student's Status & Reflection submission has not been evaluated against the instructor's rubric."
                                <%= image_tag "question-circle-fill.svg",
                                    class: "team-status-icon",
                                    alt: "",
                                    aria: { hidden: true } %>
                              </span>
                              <span class="text-muted">Not Evaluated</span>
                            </div>
                          </td>
                        </tr>
                      <% end %>
                    </tbody>
                  </table>
                </div>

              </div>
              
            </div>
          </div>

        <% end %>
        <% if ["Sprint 2", "Sprint 3", "Sprint 4"].include?(sprint) %>
          <% sprint_number = sprint.split.last %>
          <% attached = @sponsor_csv_attached[sprint] %>

          <div class="sponsor-response-section mt-4 pt-3 border-top">
            <h6 class="fw-bold mb-2">Sponsor Response</h6>

            <div
              class="d-flex flex-column gap-2 align-items-center"
              data-sponsor-control="<%= sprint_key %>">

              <%= form_with url: upload_sponsor_csv_semester_path(semester),
                method: :post,
                local: true,
                html: {
                  multipart: true,
                  class: "d-flex gap-2 flex-wrap justify-content-center",
                  data: {
                    sponsor_upload_form: "1",
                    sponsor_sprint_key: sprint_key
                  }
                } do %>

                <%= hidden_field_tag :sprint_number, sprint_number %>

                <%= file_field_tag :sponsor_csv,
                  accept: ".csv",
                  class: "form-control form-control-sm" %>

                <%= submit_tag "Upload",
                  class: "btn btn-ui-primary btn-sm" %>

              <% end %>

              <div
                class="d-flex gap-2 <%= attached ? '' : 'd-none' %>"
                data-sponsor-actions>

                <button
                  type="button"
                  class="btn btn-outline-primary btn-sm"
                  data-bs-toggle="modal"
                  data-bs-target="#sponsorSummaryModal-<%= sprint_key %>">
                  Summary
                </button>

                <button
                  type="button"
                  class="btn btn-outline-secondary btn-sm"
                  data-bs-toggle="modal"
                  data-bs-target="#sponsorQuestionsModal-<%= sprint_key %>">
                  Questions
                </button>

              </div>

              <span
                class="text-muted small <%= attached ? 'd-none' : '' %>"
                data-sponsor-upload-hint>
                Upload CSV first
              </span>

              <span
                class="small"
                data-sponsor-upload-feedback>
              </span>

            </div>
          </div>
        <% end %>
      </div>
      
    <% end %>
    
  </div>

</div>
