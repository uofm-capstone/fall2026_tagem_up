<!-- TABLE -->
<div class="table-responsive team-status-table-wrap">

  <div class="status-card-layout">
    <% teams.each do |team| %>
      <div class="card mb-4">
        <div class="card-header">
          <strong><%= team.name %></strong>
        </div>

        <div class="card-body">

          <% sprint_list.each do |sprint| %>
            <% team_metric = team_sprint_metrics.dig(team.id, sprint) || {} %>

            <div class="sprint-group <%= sprint.parameterize %>">

              <div class="stage-layout" data-card-stage="planning">
                <h6 class="fw-bold mb-2">Team Evaluation</h6>

                <div class="table-responsive mb-4">
                  <table class="table table-bordered text-center align-middle mb-0">
                    <thead>
                      <tr>
                        <th>Feature Selection &amp; Decomposition</th>
                        <th>Feature Assignments</th>
                      </tr>
                    </thead>

                    <tbody>
                      <tr>
                        <td>
                          B: <%= team_metric[:backlog_cards] || 0 %> ·
                          T: <%= team_metric[:todo_cards] || 0 %> ·
                          IP: <%= team_metric[:in_progress_cards] || 0 %> ·
                          D: <%= team_metric[:done_cards] || 0 %>
                        </td>

                        <td>
                          <%= team.students.sum { |student|
                            status_metrics.dig(
                              team.id,
                              student.id,
                              sprint,
                              :fa,
                              :assigned_cards
                            ).to_i
                          } %>
                        </td>
                      </tr>
                    </tbody>
                  </table>
                </div>

                <h6 class="fw-bold mb-2">Individual Evaluation</h6>

                <div class="table-responsive">
                  <table class="table table-bordered text-center align-middle mb-0">
                    <thead>
                      <tr>
                        <th>Member</th>
                        <th>Time Estimate</th>
                      </tr>
                    </thead>

                    <tbody>
                      <% team.students.each do |student| %>
                        <% metric = status_metrics.dig(team.id, student.id, sprint) || {} %>

                        <tr>
                          <td>
                            <%= "#{student.name.split.first} #{student.name.split.last&.first}." %>
                          </td>

                          <td>
                            <%= metric.dig(:te, :estimated_hours) || 0 %>
                          </td>
                        </tr>
                      <% end %>
                    </tbody>
                  </table>
                </div>
              </div>

              <div class="stage-layout" data-card-stage="progress">

                <h6 class="fw-bold mb-2">Team Evaluation</h6>

                <div class="alert alert-light border text-center mb-4">
                  No team-level metrics currently available.
                </div>

                <h6 class="fw-bold mb-2">Individual Evaluation</h6>

                <div class="table-responsive">
                  <table class="table table-bordered text-center align-middle mb-0">
                    <thead>
                      <tr>
                        <th>Member</th>
                        <th>Time Spent</th>
                        <th>Last Commit</th>
                        <th>Product Progress</th>
                      </tr>
                    </thead>

                    <tbody>
                      <% team.students.each do |student| %>
                        <% metric = status_metrics.dig(team.id, student.id, sprint) || {} %>
                        <% done_count = metric.dig(:fsd, :done).to_i %>
                        <% total_count = metric.dig(:fa, :assigned_cards).to_i %>

                        <tr>
                          <td>
                            <%= "#{student.name.split.first} #{student.name.split.last&.first}." %>
                          </td>

                          <td>
                            <%= metric.dig(:ts, :time_spent_hours) || 0 %>
                          </td>

                          <td>
                            <span class="github-band">
                              <%= formatted_last_commit_display(metric) %>
                            </span>
                          </td>

                          <td>
                            <%= metric.dig(:pp, :completion_pct) || 0 %>%
                            (<%= metric.dig(:pp, :band) || "No Data" %>)

                            <div class="github-band">
                              <%= done_count %>/<%= total_count %> done
                            </div>
                          </td>
                        </tr>
                      <% end %>
                    </tbody>
                  </table>
                </div>

              </div>

              <div class="stage-layout" data-card-stage="demo">

                <h6 class="fw-bold mb-2">Team Evaluation</h6>

                <div class="alert alert-light border text-center mb-4">
                  No team-level metrics currently available.
                </div>

                <h6 class="fw-bold mb-2">Individual Evaluation</h6>

                <div class="table-responsive">
                  <table class="table table-bordered text-center align-middle mb-0">
                    <thead>
                      <tr>
                        <th>Member</th>
                        <th>Time Spent</th>
                        <th>Last Commit</th>
                        <th>Product Progress</th>
                      </tr>
                    </thead>

                    <tbody>
                      <% team.students.each do |student| %>
                        <% metric = status_metrics.dig(team.id, student.id, sprint) || {} %>
                        <% done_count = metric.dig(:fsd, :done).to_i %>
                        <% total_count = metric.dig(:fa, :assigned_cards).to_i %>

                        <tr>
                          <td>
                            <%= "#{student.name.split.first} #{student.name.split.last&.first}." %>
                          </td>

                          <td>
                            <%= metric.dig(:ts, :time_spent_hours) || 0 %>
                          </td>

                          <td>
                            <span class="github-band">
                              <%= formatted_last_commit_display(metric) %>
                            </span>
                          </td>

                          <td>
                            <%= metric.dig(:pp, :completion_pct) || 0 %>%
                            (<%= metric.dig(:pp, :band) || "No Data" %>)

                            <div class="github-band">
                              <%= done_count %>/<%= total_count %> done
                            </div>
                          </td>
                        </tr>
                      <% end %>
                    </tbody>
                  </table>
                </div>

              </div>

            </div>
          <% end %>

        </div>
      </div>
    <% end %>
  </div>
  
</div>
